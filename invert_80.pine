//@version=6
indicator("INVERT v5 - 80% WINRATE", overlay=false, precision=2, max_boxes_count=200, max_labels_count=300)

grpM = "Tryb"
preset = input.string("Zbalansowany 80%", "Preset TP/SL",
     options=["Maks. skutecznosc", "Zbalansowany 80%", "Maks. zysk", "Reczny"], group=grpM)
invert = input.bool(true, "GRAJ NA ODWROT", group=grpM)
minTier = input.int(1, "Min tier", minval=1, maxval=3, group=grpM)
closeOnFlip = input.bool(true, "Zamykaj na flipie", group=grpM)

grpO = "Oscylator"
rsiLen   = input.int(14, "RSI", minval=2, group=grpO)
stochLen = input.int(14, "Stoch", minval=2, group=grpO)
kSm      = input.int(3, "K smooth", minval=1, group=grpO)
dSm      = input.int(3, "D smooth", minval=1, group=grpO)

grpL = "Poziomy"
sellLvl    = input.float(70, "Sell", group=grpL)
supSellLvl = input.float(80, "Super Sell", group=grpL)
megSellLvl = input.float(90, "Mega Sell", group=grpL)
buyLvl     = input.float(30, "Buy", group=grpL)
supBuyLvl  = input.float(20, "Super Buy", group=grpL)
megBuyLvl  = input.float(10, "Mega Buy", group=grpL)

grpX = "TP / SL"
atrLen   = input.int(14, "ATR len", minval=2, group=grpX)
tpAtrIn  = input.float(1.0, "TP x ATR", minval=0.1, maxval=10, step=0.1, group=grpX)
slAtrIn  = input.float(2.5, "SL x ATR", minval=0.1, maxval=10, step=0.1, group=grpX)
useTrail = input.bool(false, "Trailing po 1xATR", group=grpX)

grpZ = "Strefy / styl"
showZones   = input.bool(true, "Strefy", group=grpZ)
zoneLimit   = input.int(4, "Strefy/strona", minval=1, maxval=12, group=grpZ)
zoneWidthA  = input.float(0.35, "Grubosc x ATR", minval=0.05, maxval=3, step=0.05, group=grpZ)
extendBars  = input.int(25, "Przedluzenie", minval=5, maxval=100, group=grpZ)
showSignals = input.bool(true, "Etykiety", group=grpZ)
buyCol  = input.color(#089981, "BUY", group=grpZ)
sellCol = input.color(#f23645, "SELL", group=grpZ)
rsiCol  = input.color(#5b9cf6, "RSI", group=grpZ)

// --- preset TP/SL ---
tpAtr = preset == "Maks. skutecznosc" ? 0.5 : preset == "Zbalansowany 80%" ? 1.0 : preset == "Maks. zysk" ? 3.0 : tpAtrIn
slAtr = preset == "Maks. skutecznosc" ? 4.0 : preset == "Zbalansowany 80%" ? 2.5 : preset == "Maks. zysk" ? 2.0 : slAtrIn
float breakeven = 100.0 * slAtr / (tpAtr + slAtr)

// --- core ---
rsi      = ta.rsi(close, rsiLen)
stochRaw = ta.stoch(rsi, rsi, rsi, stochLen)
k        = ta.sma(stochRaw, kSm)
d        = ta.sma(k, dSm)
atr      = ta.atr(atrLen)
atrSafe  = nz(atr, math.max(high - low, syminfo.mintick))
zoneW    = math.max(atrSafe * zoneWidthA, syminfo.mintick * 2)

buyTier  = na(k) ? 0 : k <= megBuyLvl ? 3 : k <= supBuyLvl ? 2 : k <= buyLvl ? 1 : 0
sellTier = na(k) ? 0 : k >= megSellLvl ? 3 : k >= supSellLvl ? 2 : k >= sellLvl ? 1 : 0

// --- strefy ---
var array<box> bBx = array.new<box>()
var array<box> sBx = array.new<box>()
var int seenB = 0
var int seenS = 0
newB = false
newS = false

f_name(bool isBuy, int tier) =>
    (tier == 3 ? "MEGA " : tier == 2 ? "SUPER " : "") + (isBuy ? "BUY" : "SELL")

f_box(array<box> bx, bool isBuy, int tier) =>
    float top = isBuy ? low + zoneW : high
    float bot = isBuy ? low : high - zoneW
    color c   = isBuy ? buyCol : sellCol
    box b = box.new(bar_index, top, bar_index + extendBars, bot, border_color = color.new(c, 20), bgcolor = color.new(c, 83), text = f_name(isBuy, tier), text_size = size.tiny, text_color = chart.fg_color, force_overlay = true)
    array.push(bx, b)
    if array.size(bx) > zoneLimit
        box.delete(array.shift(bx))

if barstate.isconfirmed
    if buyTier == 0
        seenB := 0
    if buyTier > seenB
        seenB := buyTier
        if buyTier >= minTier
            newB := true
            if showZones
                f_box(bBx, true, buyTier)
    if sellTier == 0
        seenS := 0
    if sellTier > seenS
        seenS := sellTier
        if sellTier >= minTier
            newS := true
            if showZones
                f_box(sBx, false, sellTier)

// --- sygnaly z odwroceniem ---
longEntry  = invert ? newS : newB
shortEntry = invert ? newB : newS
entryTier  = invert ? (newS ? sellTier : buyTier) : (newB ? buyTier : sellTier)

// --- statystyki ---
var int  pos    = 0
var float ePx   = na
var float sPx   = na
var float tPx   = na
var int  eTier  = 0
var int  wins   = 0
var int  losses = 0
var int  be     = 0
var float sumR  = 0.0

if barstate.isconfirmed
    if pos != 0
        bool hitSl = pos == 1 ? low <= sPx : high >= sPx
        bool hitTp = pos == 1 ? high >= tPx : low <= tPx
        bool flip  = closeOnFlip and ((pos == 1 and shortEntry) or (pos == -1 and longEntry))
        if hitTp
            wins += 1
            sumR += tpAtr
            pos := 0
        else if hitSl
            losses += 1
            sumR -= slAtr
            pos := 0
        else if flip
            float move = pos == 1 ? (close - ePx) / atrSafe : (ePx - close) / atrSafe
            if move > 0
                wins += 1
            else if move < 0
                losses += 1
            else
                be += 1
            sumR += move
            pos := 0
        else if useTrail and pos != 0
            float trailAmt = 1.0 * atrSafe
            sPx := pos == 1 ? math.max(sPx, close - trailAmt) : math.min(sPx, close + trailAmt)
    if pos == 0
        if longEntry
            pos := 1
            ePx := close
            sPx := close - slAtr * atrSafe
            tPx := close + tpAtr * atrSafe
            eTier := entryTier
        else if shortEntry
            pos := -1
            ePx := close
            sPx := close + slAtr * atrSafe
            tPx := close - tpAtr * atrSafe
            eTier := entryTier

int nTr = wins + losses + be
float wr = nTr > 0 ? 100.0 * wins / nTr : na
float expR = nTr > 0 ? sumR / nTr : na

// --- rysowanie ---
plot(rsi, "RSI", color = rsiCol)
plot(k, "K", color = buyCol, linewidth = 2)
plot(d, "D", color = sellCol)
hline(0, "0", color = color.new(chart.fg_color, 85))
hline(megBuyLvl, "Mega Buy", color = color.new(buyCol, 45), linestyle = hline.style_dashed)
hline(supBuyLvl, "Super Buy", color = color.new(buyCol, 55), linestyle = hline.style_dashed)
hline(buyLvl, "Buy", color = color.new(buyCol, 65), linestyle = hline.style_dashed)
hline(50, "50", color = color.new(chart.fg_color, 80), linestyle = hline.style_dotted)
hline(sellLvl, "Sell", color = color.new(sellCol, 65), linestyle = hline.style_dashed)
hline(supSellLvl, "Super Sell", color = color.new(sellCol, 55), linestyle = hline.style_dashed)
hline(megSellLvl, "Mega Sell", color = color.new(sellCol, 45), linestyle = hline.style_dashed)
hline(100, "100", color = color.new(chart.fg_color, 85))

if barstate.isconfirmed and showSignals and newB
    label.new(bar_index, low, (invert ? "SHORT " : "LONG ") + str.tostring(buyTier), style = label.style_label_up, color = buyCol, textcolor = color.white, size = size.tiny, force_overlay = true)
if barstate.isconfirmed and showSignals and newS
    label.new(bar_index, high, (invert ? "LONG " : "SHORT ") + str.tostring(sellTier), style = label.style_label_down, color = sellCol, textcolor = color.white, size = size.tiny, force_overlay = true)

plot(pos != 0 ? ePx : na, "Entry", color = color.gray, style = plot.style_linebr, force_overlay = true)
plot(pos != 0 ? sPx : na, "SL", color = color.red, style = plot.style_linebr, force_overlay = true)
plot(pos != 0 ? tPx : na, "TP", color = color.green, style = plot.style_linebr, force_overlay = true)
// --- tabela ---
var table tb = table.new(position.top_right, 2, 6, border_width = 1, frame_color = color.new(chart.fg_color, 60), frame_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, invert ? "ODWROCONY" : "NORMALNY", text_color = color.white, bgcolor = color.new(#1e88e5, 20), text_size = size.small)
    table.cell(tb, 1, 0, preset, text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 85), text_size = size.small)
    table.cell(tb, 0, 1, "TP / SL", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(tpAtr) + "x / " + str.tostring(slAtr) + "x ATR", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 0, 2, "Skutecznosc", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 1, 2, na(wr) ? "brak prob" : str.tostring(math.round(wr)) + "% (W" + str.tostring(wins) + "/L" + str.tostring(losses) + ")", text_color = na(wr) ? chart.fg_color : wr >= 70 ? buyCol : sellCol, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 0, 3, "Breakeven", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(math.round(breakeven)) + "%", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 0, 4, "Expectancy", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 1, 4, na(expR) ? "-" : str.tostring(expR, "#.##") + " ATR/trade", text_color = na(expR) ? chart.fg_color : expR > 0 ? buyCol : sellCol, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 0, 5, "Pozycja", text_color = chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)
    table.cell(tb, 1, 5, pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "brak", text_color = pos == 1 ? buyCol : pos == -1 ? sellCol : chart.fg_color, bgcolor = color.new(chart.fg_color, 90), text_size = size.small)

// --- alerty ---
alertcondition(longEntry, "LONG", "LONG entry")
alertcondition(shortEntry, "SHORT", "SHORT entry")
if longEntry
    alert("LONG " + str.tostring(close), alert.freq_once_per_bar_close)
if shortEntry
    alert("SHORT " + str.tostring(close), alert.freq_once_per_bar_close)